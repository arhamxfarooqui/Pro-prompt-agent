{
  "manifest_version": 3,
  "name": "Local Agentic Orchestrator",
  "version": "1.0.0",
  "description": "Zero-egress local agentic prompt engine explicitly orchestrating LangGraph boundaries totally offline.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/module3_ui/content.js",
        "src/module3_ui/autocomplete-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/module3_ui/styles.css",
        "src/module1_engine/worker.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
