{
  "manifest_version": 3,
  "name": "Local Agentic Orchestrator",
  "version": "1.0.0",
  "description": "Zero-egress local agentic prompt engine with LangGraph orchestration.",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "activeTab",
    "storage",
    "offscreen",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content.js",
        "autocomplete-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "styles.css",
        "worker.js",
        "registry.json",
        "chunks/*"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
